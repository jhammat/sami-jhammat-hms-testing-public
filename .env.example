# ============================================================
# WonFlow Environment Example
# ============================================================
#
# Copy this file to:
#
# .env.local
#
# Never commit real production credentials.
# Values beginning with NEXT_PUBLIC_ may be visible in browsers.
#

# ------------------------------------------------------------
# General environment
# ------------------------------------------------------------

NODE_ENV=development
WONFLOW_ENVIRONMENT=development

# ------------------------------------------------------------
# Browser-visible application configuration
# ------------------------------------------------------------

NEXT_PUBLIC_WONFLOW_APP_NAME=WonFlow
NEXT_PUBLIC_WONFLOW_APP_URL=http://localhost:3000

# Production WebRTC ICE configuration. Use your own authenticated TURN service
# so calls work reliably across carrier-grade NAT and restricted networks.
# Example: [{"urls":["stun:turn.example.com:3478","turn:turn.example.com:3478"],"username":"wonflow","credential":"replace-me"}]
WONFLOW_WEBRTC_ICE_SERVERS_JSON=

NEXT_PUBLIC_WONFLOW_DEFAULT_LOCALE=en

NEXT_PUBLIC_WONFLOW_DATA_MODE=mock
NEXT_PUBLIC_WONFLOW_ENABLE_DEMO=true
NEXT_PUBLIC_WONFLOW_DEMO_SCENARIO=hospital-day

NEXT_PUBLIC_WONFLOW_SHOW_ENVIRONMENT_BANNER=true
NEXT_PUBLIC_WONFLOW_ENABLE_PATIENT_ACCESS=true

NEXT_PUBLIC_WONFLOW_BUILD_ID=local-development

# ------------------------------------------------------------
# Server-only database configuration
# ------------------------------------------------------------

DATABASE_URL=postgresql://wonflow:wonflow_local_only@localhost:5432/wonflow
DIRECT_URL=

# ------------------------------------------------------------
# Server-only security values
# ------------------------------------------------------------

SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

ALLOW_MOCK_DATA=true

# ------------------------------------------------------------
# Optional Redis configuration
# ------------------------------------------------------------

REDIS_URL=

# ------------------------------------------------------------
# Optional object-storage configuration
# Configure all four values together.
# ------------------------------------------------------------

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ------------------------------------------------------------
# Optional SMTP configuration
# ------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

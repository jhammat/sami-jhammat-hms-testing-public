{
  "name": "wonflow",
  "version": "0.1.0",
  "private": true,
  "description": "WonFlow multi-organization and multi-branch hospital management platform",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm db:client && pnpm demo:strings:check && pnpm --filter web build",
    "db:client": "pnpm --filter @wonflow/database db:generate",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "lint:fix": "pnpm --filter web lint:fix",
    "typecheck": "pnpm -r run --if-present --no-bail typecheck",
    "db:format": "node tooling/scripts/check-env.mjs DATABASE_URL && pnpm --filter @wonflow/database db:format",
    "db:generate": "node tooling/scripts/check-env.mjs DATABASE_URL && pnpm --filter @wonflow/database db:generate",
    "db:validate": "node tooling/scripts/check-env.mjs DATABASE_URL && pnpm --filter @wonflow/database db:validate",
    "db:migrate": "node tooling/scripts/check-env.mjs DATABASE_URL && pnpm --filter @wonflow/database db:migrate",
    "db:migrate:safe": "node tooling/scripts/check-env.mjs DATABASE_URL && node tooling/scripts/create-migration.mjs",
    "db:deploy": "node tooling/scripts/check-env.mjs DATABASE_URL && pnpm --filter @wonflow/database db:deploy",
    "db:studio": "node tooling/scripts/check-env.mjs DATABASE_URL && pnpm --filter @wonflow/database db:studio",
    "check": "pnpm lint && pnpm typecheck && pnpm db:validate && pnpm demo:strings:check && git diff --check",
    "check:full": "pnpm check && pnpm build",
    "doctor": "node tooling/scripts/doctor.mjs",
    "clean": "node tooling/scripts/clean.mjs",
    "demo:strings:check": "node tooling/scripts/check-demo-storage-strings.mjs",
    "demo:genericity": "node tooling/scripts/p1-31-genericity-audit.mjs",
    "demo:gate": "node tooling/scripts/p1-31-demo-gate.mjs",
    "phase:audit": "node tooling/scripts/phase-one-scope-audit.mjs",
    "test": "pnpm -r run --if-present test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:coverage": "pnpm --filter web test:coverage",
    "db:backup": "node tooling/scripts/postgres-backup.mjs",
    "db:provision-roles": "pnpm exec tsx tooling/scripts/provision-database-roles.ts",
    "worker:dev": "pnpm --filter @wonflow/worker dev",
    "runtime:audit": "node tooling/scripts/production-runtime-audit.mjs",
    "db:seed:prod": "pnpm exec tsx tooling/scripts/seed-production.ts",
    "db:seed:dev": "pnpm exec tsx tooling/scripts/seed-development-logins.ts",
    "db:repair-access": "pnpm exec tsx tooling/scripts/repair-workspace-access.ts",
    "db:seed:demo": "pnpm exec tsx tooling/scripts/seed-demo-data.ts",
    "db:seed:allied": "pnpm exec tsx tooling/scripts/populate-allied-and-patient-demo.ts",
    "db:seed:hpb": "pnpm exec tsx tooling/scripts/seed-hpb-demo.ts",
    "db:seed:sjh": "pnpm exec tsx tooling/scripts/seed-sami-jhammat-hospital.ts",
    "db:diagnose:booking": "pnpm exec tsx tooling/scripts/diagnose-patient-booking.ts",
    "db:reset:superadmin": "pnpm exec tsx tooling/scripts/reset-to-fresh-superadmin.ts"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.23.5"
  }
}

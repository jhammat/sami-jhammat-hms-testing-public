{
  "name": "@wonflow/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared runtime configuration and environment rules for WonFlow.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "audit:config": "node ./scripts/audit-config.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node ./scripts/audit-config.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@wonflow/contracts": "workspace:*",
    "@wonflow/validation": "workspace:*",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}

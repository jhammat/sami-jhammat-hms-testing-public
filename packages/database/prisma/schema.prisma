  Tenant         Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId, planId, displayOrder])
  @@index([tenantId, carePlanTaskId])
}

enum AlertMetricType {
  OBSERVATION
  DRAIN
  SYMPTOM
  TASK_ADHERENCE
  WEIGHT_CHANGE
  LAB_VALUE
}

enum AlertComparator {
  GT
  GTE
  LT
  LTE
  EQ
  CHANGE_BY
  CHANGE_TO
  MISSED_COUNT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  EXPIRED
}

enum AlertEscalationChannel {
  PUSH
  SMS
  CALL
}

model AlertRule {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String             @db.Uuid
  name                  String             @db.VarChar(200)
  description           String?
  patientCategory       String?            @db.VarChar(120)
  metricType            AlertMetricType
  metricCode            String             @db.VarChar(100)
  comparator            AlertComparator
  thresholdValue        String             @db.VarChar(100)
  thresholdSecondary    String?            @db.VarChar(100)
  windowHours           Int?
  severity              AlertSeverity      @default(WARNING)
  isActive              Boolean            @default(true)
  createdByMembershipId String?            @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)
  Tenant                Tenant             @relation(fields: [tenantId], references: [id])
  CreatedBy             TenantMembership?  @relation(fields: [createdByMembershipId], references: [id])
  PatientAlertRules     PatientAlertRule[]
  AlertEvents           AlertEvent[]

  @@index([tenantId, metricType, isActive])
  @@index([tenantId, metricCode])
}

model PatientAlertRule {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String        @db.Uuid
  patientId              String        @db.Uuid
  ruleId                 String        @db.Uuid
  overrideThresholdValue String?       @db.VarChar(100)
  overrideSeverity       AlertSeverity?
  isDisabled             Boolean       @default(false)
  notes                  String?
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(6)
  Tenant                 Tenant        @relation(fields: [tenantId], references: [id])
  Patient                Patient       @relation(fields: [patientId], references: [id])
  AlertRule              AlertRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId, ruleId])
  @@index([tenantId, ruleId])
}

model AlertEvent {
  id                         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String            @db.Uuid
  patientId                  String            @db.Uuid
  ruleId                     String?           @db.Uuid
  title                      String            @db.VarChar(250)
  description                String?
  metricType                 AlertMetricType
  metricCode                 String            @db.VarChar(100)
  metricValue                String            @db.VarChar(100)
  sourceRecordType           String            @db.VarChar(100)
  sourceRecordId             String?           @db.Uuid
  severity                   AlertSeverity     @default(WARNING)
  status                     AlertEventStatus  @default(OPEN)
  deviceRecordedAt           DateTime?         @db.Timestamptz(6)
  triggeredAt                DateTime          @default(now()) @db.Timestamptz(6)
  acknowledgedByMembershipId String?           @db.Uuid
  acknowledgedAt             DateTime?         @db.Timestamptz(6)
  resolvedByMembershipId     String?           @db.Uuid
  resolvedAt                 DateTime?         @db.Timestamptz(6)
  resolutionNotes            String?
  createdAt                  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(6)
  Tenant                     Tenant            @relation(fields: [tenantId], references: [id])
  Patient                    Patient           @relation(fields: [patientId], references: [id])
  AlertRule                  AlertRule?        @relation(fields: [ruleId], references: [id])
  AcknowledgedBy             TenantMembership? @relation("AlertEventAcknowledgedBy", fields: [acknowledgedByMembershipId], references: [id])
  ResolvedBy                 TenantMembership? @relation("AlertEventResolvedBy", fields: [resolvedByMembershipId], references: [id])
  Escalations                AlertEscalation[]

  @@index([tenantId, status, severity, triggeredAt])
  @@index([tenantId, patientId, status])
  @@index([tenantId, ruleId])
}

model AlertRota {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String           @db.Uuid
  dayOfWeek              Int
  startMinute            Int
  endMinute              Int
  severity               AlertSeverity    @default(WARNING)
  primaryMembershipId    String           @db.Uuid
  escalationMembershipId String           @db.Uuid
  createdAt              DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(6)
  Tenant                 Tenant           @relation(fields: [tenantId], references: [id])
  PrimaryMembership      TenantMembership @relation("AlertRotaPrimary", fields: [primaryMembershipId], references: [id])
  EscalationMembership   TenantMembership @relation("AlertRotaEscalation", fields: [escalationMembershipId], references: [id])

  @@index([tenantId, dayOfWeek, severity])
}

model AlertEscalation {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                 @db.Uuid
  alertEventId       String                 @db.Uuid
  step               Int
  channel            AlertEscalationChannel @default(PUSH)
  targetMembershipId String                 @db.Uuid
  scheduledFor       DateTime               @default(now()) @db.Timestamptz(6)
  sentAt             DateTime?              @db.Timestamptz(6)
  deliveredAt        DateTime?              @db.Timestamptz(6)
  acknowledgedAt     DateTime?              @db.Timestamptz(6)
  failedAt           DateTime?              @db.Timestamptz(6)
  failureReason      String?
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)
  Tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  AlertEvent         AlertEvent             @relation(fields: [alertEventId], references: [id], onDelete: Cascade)
  TargetMembership   TenantMembership       @relation(fields: [targetMembershipId], references: [id])

  @@index([tenantId, alertEventId, step])
  @@index([tenantId, scheduledFor, sentAt])
}

/// A doctor's request to create a new consultation service or change an
/// existing service fee. Only used when the organization's doctorFeeAuthority
/// is APPROVAL_REQUIRED. The admin reviews each request and approves or
/// declines it.
model DoctorFeeRequest {
  id                      String                 @id @default(uuid()) @db.Uuid
  tenantId                String                 @db.Uuid
  serviceId               String?                @db.Uuid
  doctorId                String                 @db.Uuid
  requestedByMembershipId String                 @db.Uuid

  /// CREATE_SERVICE for new services, UPDATE_FEE for price changes.
  requestType             DoctorFeeRequestType
  proposedName            String?                @db.VarChar(250)
  proposedDescription     String?
  proposedDurationMinutes Int?
  proposedPriceMinorUnits Int
  proposedCurrencyCode    String                 @default("PKR") @db.Char(3)
  proposedBranchId        String?                @db.Uuid
  proposedPubliclyBookable Boolean               @default(false)
  proposedConsultationModes ConsultationMode[]   @default([IN_PERSON])

  /// Approval workflow status.
  status                  DoctorFeeRequestStatus @default(PENDING)
  reviewedByMembershipId  String?                @db.Uuid
  reviewNote              String?
  rejectionReason         String?

  createdAt               DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(6)
  reviewedAt              DateTime?              @db.Timestamptz(6)

  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor                  DoctorProfile          @relation(fields: [doctorId], references: [id])
  service                 ServiceDefinition?     @relation(fields: [serviceId], references: [id])
  requestedBy             TenantMembership       @relation("FeeRequestRequester", fields: [requestedByMembershipId], references: [id])
  reviewedBy              TenantMembership?      @relation("FeeRequestReviewer", fields: [reviewedByMembershipId], references: [id])
  proposedBranch          Branch?                @relation(fields: [proposedBranchId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, doctorId, status])
  @@index([serviceId])
  @@index([doctorId])
  @@index([requestedByMembershipId])
  @@index([reviewedByMembershipId])
  @@index([proposedBranchId])
}

enum DoctorFeeRequestType {
  CREATE_SERVICE
  UPDATE_FEE
}

enum DoctorFeeRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// One clinician confirming they have seen another discipline's entry on a
/// patient's record.
///
/// Deliberately generic — `entryType` + `entryId` point at any row in the care
/// timeline (a nutrition plan, a therapy session, a diagnosis) rather than a
/// column per feature, so acknowledging works the same way for every kind of
/// entry and a new entry type needs no migration.
///
/// The unique constraint makes acknowledging idempotent: pressing the button
/// twice, or two tabs racing, leaves one row rather than a duplicate audit
/// trail.
model ClinicalAcknowledgement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  patientId      String   @db.Uuid
  entryType      String   @db.VarChar(60)
  entryId        String   @db.VarChar(200)
  membershipId   String   @db.Uuid
  note           String?  @db.VarChar(1000)
  acknowledgedAt DateTime @default(now()) @db.Timestamptz(6)

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entryType, entryId, membershipId])
  @@index([tenantId, patientId, acknowledgedAt])
  @@index([membershipId])
  @@index([patientId])
}

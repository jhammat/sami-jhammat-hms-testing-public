/// A resumable chunked upload in progress. Chunks are appended, in order, to a
/// temp file on disk keyed by this session's id; nextChunkIndex/receivedBytes
/// let an interrupted client learn where to resume instead of restarting.
model DocumentUploadSession {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  patientId      String               @db.Uuid
  fileName       String               @db.VarChar(500)
  contentType    String               @db.VarChar(250)
  category       String               @db.VarChar(100)
  title          String               @db.VarChar(300)
  totalSizeBytes BigInt
  chunkSizeBytes Int
  receivedBytes  BigInt               @default(0)
  nextChunkIndex Int                  @default(0)
  status         DocumentUploadStatus @default(IN_PROGRESS)
  expiresAt      DateTime             @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  tenant         Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId, patientId, status])
}

/// A short-lived, single-use capability to fetch one document's bytes without
/// a re-authenticated session round trip. usedAt is set atomically on first
/// successful fetch; a second attempt with the same token is refused.
model DocumentAccessToken {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  documentId String         @db.Uuid
  token      String         @unique @db.VarChar(128)
  expiresAt  DateTime       @db.Timestamptz(6)
  usedAt     DateTime?      @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  document   DocumentRecord @relation(fields: [documentId], references: [id])
  tenant     Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId, documentId])
  @@index([documentId])
}


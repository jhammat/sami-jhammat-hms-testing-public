generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DoctorFeeAuthority {
  DOCTOR
  HOSPITAL
}

/// Lifecycle of a hospital policy document.
enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Who is allowed to set and change a service price.
enum ServiceBillingOwner {
  HOSPITAL
  DEPARTMENT
  DOCTOR
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum IdentityStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION_ACCEPTANCE
  MFA_RECOVERY
}

enum TokenStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

enum MfaStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum WorkspaceCode {
  ADMIN
  RECEPTION
  DOCTOR
  PATIENT
  LABORATORY
  RADIOLOGY
  PHARMACY
  BILLING
  MANAGEMENT
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
  ARCHIVED
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  ARCHIVED
}

enum DoctorSittingStatus {
  PLANNED
  AVAILABLE
  ON_BREAK
  FINISHED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ConsultationMode {
  IN_PERSON
  ONLINE
}

enum VideoCallStatus {
  WAITING
  ACTIVE
  ENDED
}

enum EncounterStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ENTERED_IN_ERROR
}

enum DiagnosticType {
  LABORATORY
  RADIOLOGY
}

enum DiagnosticStatus {
  DRAFT
  ORDERED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ENTERED_IN_ERROR
}

enum DiagnosticResultStatus {
  PRELIMINARY
  FINAL
  AMENDED
  CORRECTED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum InventoryBatchStatus {
  AVAILABLE
  QUARANTINED
  EXPIRED
  RECALLED
  DEPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  REFUNDED
}

enum StoredObjectStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  REJECTED
  DELETED
}

enum DocumentStatus {
  DRAFT
  AVAILABLE
  RELEASED
  ARCHIVED
  DELETED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum AuditSeverity {
  INFORMATION
  WARNING
  CRITICAL
}

enum SubscriptionStatus {
  UNCONFIGURED
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SupportAccessStatus {
  REQUESTED
  APPROVED
  ACTIVE
  EXPIRED
  REVOKED
  REJECTED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum QueueStatus {
  OPEN
  PAUSED
  CLOSED
}

enum QueueEntryStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  MISSED
  CANCELLED
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
  RELEASED
  AMENDED
  VOID
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  ENTERED_IN_ERROR
}

enum DiagnosisCertainty {
  PROVISIONAL
  DIFFERENTIAL
  CONFIRMED
  REFUTED
}

enum AllergyStatus {
  ACTIVE
  INACTIVE
  RESOLVED
  ENTERED_IN_ERROR
}

enum ObservationStatus {
  PRELIMINARY
  FINAL
  AMENDED
  ENTERED_IN_ERROR
}

enum SpecimenStatus {
  REQUESTED
  COLLECTED
  RECEIVED
  REJECTED
  PROCESSING
  STORED
  DISPOSED
}

enum StockMovementType {
  RECEIPT
  DISPENSE
  RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  EXPIRY
  RECALL
}

enum DispenseStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  PARTIALLY_COMPLETED
  CANCELLED
  RETURNED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum DeviceApplication {
  PATIENT
  DOCTOR
  STAFF
}

model Tenant {
  id                  String       @id @default(uuid()) @db.Uuid
  slug                String       @unique @db.VarChar(120)
  displayName         String       @db.VarChar(200)
  legalName           String?      @db.VarChar(250)
  domain              String?      @unique @db.VarChar(250)
  status              TenantStatus @default(DRAFT)
  defaultLocale       String       @default("en") @db.VarChar(20)
  secondaryLocale     String?      @default("ur") @db.VarChar(20)
  defaultTimezone     String       @default("Asia/Karachi") @db.VarChar(100)
  defaultCurrencyCode String       @default("PKR") @db.Char(3)
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)
  archivedAt          DateTime?    @db.Timestamptz(6)

  organizations        Organization[]
  policies             PolicyDocument[]
  policyVersions       PolicyDocumentVersion[]
  memberships          TenantMembership[]
  sessions             AuthSession[]
  invitations          TenantInvitation[]
  roles                Role[]
  rolePermissions      RolePermission[]
  roleAssignments      MembershipRole[]
  permissionGrants     MembershipPermissionGrant[]
  patients             Patient[]
  staffProfiles        StaffProfile[]
  services             ServiceDefinition[]
  availabilityRules    AvailabilityRule[]
  appointments         Appointment[]
  encounters           Encounter[]
  diagnosticOrders     DiagnosticOrder[]
  medications          Medication[]
  inventoryBatches     InventoryBatch[]
  prescriptions        Prescription[]
  invoices             Invoice[]
  payments             Payment[]
  storedObjects        StoredObject[]
  documents            DocumentRecord[]
  notifications        Notification[]
  auditEvents          AuditEvent[]
  subscription         TenantSubscription?
  entitlements         TenantEntitlement[]
  supportAccess        SupportAccessGrant[]
  oneTimeTokens        OneTimeToken[]
  outboxEvents         OutboxEvent[]
  branches             Branch[]
  doctorProfiles       DoctorProfile[]
  patientIdentifiers   PatientIdentifier[]
  queues               Queue[]
  queueEntries         QueueEntry[]
  idempotencyRecords   IdempotencyRecord[]
  encounterNotes       EncounterNote[]
  encounterDiagnoses   EncounterDiagnosis[]
  patientAllergies     PatientAllergy[]
  clinicalObservations ClinicalObservation[]
  diagnosticSpecimens  DiagnosticSpecimen[]
  stockMovements       StockMovement[]
  dispenses            Dispense[]
  refunds              Refund[]
  deviceRegistrations  DeviceRegistration[]
  diagnosticResults    DiagnosticResult[]
  videoCallSessions    VideoCallSession[]
  departments          Department[]
  doctorSittings       DoctorSitting[]

  @@index([status])
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  code               String             @db.VarChar(80)
  displayName        String             @db.VarChar(200)
  legalName          String?            @db.VarChar(250)
  registrationNumber String?            @db.VarChar(120)
  email              String?            @db.VarChar(320)
  phone              String?            @db.VarChar(50)
  website            String?            @db.VarChar(500)
  logoObjectKey      String?            @db.VarChar(1000)
  status             OrganizationStatus @default(ACTIVE)
  doctorFeeAuthority DoctorFeeAuthority @default(HOSPITAL)
  settings           Json?
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  archivedAt         DateTime?          @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches    Branch[]
  departments Department[]
  memberships TenantMembership[]
  policies    PolicyDocument[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model Department {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  organizationId String    @db.Uuid
  branchId       String?   @db.Uuid
  code           String    @db.VarChar(80)
  name           String    @db.VarChar(200)
  description    String?   @db.Text
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt     DateTime? @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  doctors      DoctorProfile[]

  @@unique([tenantId, code])
  @@index([tenantId, organizationId, isActive])
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  organizationId String       @db.Uuid
  code           String       @db.VarChar(80)
  name           String       @db.VarChar(200)
  status         BranchStatus @default(ACTIVE)
  isMainBranch   Boolean      @default(false)
  email          String?      @db.VarChar(320)
  phone          String?      @db.VarChar(50)
  timezone       String       @default("Asia/Karachi") @db.VarChar(100)
  currencyCode   String       @default("PKR") @db.Char(3)
  address        Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  archivedAt     DateTime?    @db.Timestamptz(6)

  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryMemberships TenantMembership[]          @relation("MembershipPrimaryBranch")
  roleAssignments    MembershipRole[]
  permissionGrants   MembershipPermissionGrant[]
  staffProfiles      StaffProfile[]
  services           ServiceDefinition[]
  availabilityRules  AvailabilityRule[]
  appointments       Appointment[]
  encounters         Encounter[]
  inventoryBatches   InventoryBatch[]
  invoices           Invoice[]
  queues             Queue[]
  diagnosticOrders   DiagnosticOrder[]
  stockMovements     StockMovement[]
  dispenses          Dispense[]
  departments        Department[]
  doctorSittings     DoctorSitting[]

  @@unique([tenantId, code])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, isMainBranch])
}

model Identity {
  id                      String         @id @default(uuid()) @db.Uuid
  email                   String         @db.VarChar(320)
  normalizedEmail         String         @unique @db.VarChar(320)
  phone                   String?        @db.VarChar(50)
  normalizedPhone         String?        @unique @db.VarChar(50)
  passwordHash            String?        @db.VarChar(500)
  mustChangePassword      Boolean        @default(false)
  status                  IdentityStatus @default(INVITED)
  isPlatformAdministrator Boolean        @default(false)
  platformPermissionCodes String[]       @default([])
  emailVerifiedAt         DateTime?      @db.Timestamptz(6)
  phoneVerifiedAt         DateTime?      @db.Timestamptz(6)
  failedLoginCount        Int            @default(0)
  lockedUntil             DateTime?      @db.Timestamptz(6)
  passwordChangedAt       DateTime?      @db.Timestamptz(6)
  lastAuthenticatedAt     DateTime?      @db.Timestamptz(6)
  createdAt               DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @db.Timestamptz(6)
  archivedAt              DateTime?      @db.Timestamptz(6)

  memberships         TenantMembership[]
  sessions            AuthSession[]
  oneTimeTokens       OneTimeToken[]
  mfaCredentials      MfaCredential[]
  patientAccess       PatientAccess[]
  notifications       Notification[]
  deviceRegistrations DeviceRegistration[]

  @@index([status])
}

model TenantMembership {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  identityId       String           @db.Uuid
  organizationId   String           @db.Uuid
  primaryBranchId  String?          @db.Uuid
  displayName      String           @db.VarChar(250)
  photoObjectKey   String?          @db.VarChar(1000)
  status           MembershipStatus @default(INVITED)
  workspaceCodes   WorkspaceCode[]  @default([])
  primaryWorkspace WorkspaceCode?
  preferredLocale  String           @default("en") @db.VarChar(20)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  archivedAt       DateTime?        @db.Timestamptz(6)

  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identity      Identity                    @relation(fields: [identityId], references: [id], onDelete: Restrict)
  organization  Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryBranch Branch?                     @relation("MembershipPrimaryBranch", fields: [primaryBranchId], references: [id], onDelete: SetNull)
  roles         MembershipRole[]
  directGrants  MembershipPermissionGrant[]
  sessions      AuthSession[]
  staffProfile  StaffProfile?
  handledServices ServiceDefinition[] @relation("ServiceHandler")

  @@unique([tenantId, identityId])
  @@index([tenantId, status])
  @@index([identityId, status])
}

model AuthSession {
  id                String         @id @default(uuid()) @db.Uuid
  identityId        String         @db.Uuid
  membershipId      String?        @db.Uuid
  tenantId          String?        @db.Uuid
  organizationId    String?        @db.Uuid
  branchId          String?        @db.Uuid
  workspace         WorkspaceCode?
  tokenHash         String         @unique @db.Char(64)
  refreshTokenHash  String?        @unique @db.Char(64)
  refreshExpiresAt  DateTime?      @db.Timestamptz(6)
  status            SessionStatus  @default(ACTIVE)
  sourceApplication String         @db.VarChar(50)
  deviceId          String?        @db.VarChar(200)
  deviceName        String?        @db.VarChar(200)
  ipAddress         String?        @db.VarChar(100)
  userAgent         String?        @db.Text
  mfaVerifiedAt     DateTime?      @db.Timestamptz(6)
  lastSeenAt        DateTime       @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime       @db.Timestamptz(6)
  revokedAt         DateTime?      @db.Timestamptz(6)
  revocationReason  String?        @db.VarChar(500)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)

  identity   Identity          @relation(fields: [identityId], references: [id], onDelete: Cascade)
  membership TenantMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([identityId, status])
  @@index([tenantId, membershipId, status])
  @@index([expiresAt])
}

model OneTimeToken {
  id         String       @id @default(uuid()) @db.Uuid
  identityId String       @db.Uuid
  tenantId   String?      @db.Uuid
  purpose    TokenPurpose
  status     TokenStatus  @default(ACTIVE)
  tokenHash  String       @unique @db.Char(64)
  expiresAt  DateTime     @db.Timestamptz(6)
  consumedAt DateTime?    @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([identityId, purpose, status])
  @@index([expiresAt])
}

model MfaCredential {
  id                 String    @id @default(uuid()) @db.Uuid
  identityId         String    @db.Uuid
  status             MfaStatus @default(PENDING)
  label              String?   @db.VarChar(200)
  secretCiphertext   String    @db.Text
  recoveryCodeHashes String[]  @default([])
  verifiedAt         DateTime? @db.Timestamptz(6)
  lastUsedAt         DateTime? @db.Timestamptz(6)
  revokedAt          DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, status])
}

model TenantInvitation {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.Uuid
  normalizedEmail       String           @db.VarChar(320)
  displayName           String           @db.VarChar(250)
  organizationId        String           @db.Uuid
  primaryBranchId       String?          @db.Uuid
  workspaceCodes        WorkspaceCode[]  @default([])
  invitedByMembershipId String           @db.Uuid
  acceptedIdentityId    String?          @db.Uuid
  tokenId               String?          @db.Uuid
  status                MembershipStatus @default(INVITED)
  expiresAt             DateTime         @db.Timestamptz(6)
  acceptedAt            DateTime?        @db.Timestamptz(6)
  revokedAt             DateTime?        @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, normalizedEmail, status])
  @@index([expiresAt])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(160)
  category    String   @db.VarChar(100)
  label       String   @db.VarChar(200)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  rolePermissions RolePermission[]
  directGrants    MembershipPermissionGrant[]
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  code        String    @db.VarChar(120)
  name        String    @db.VarChar(200)
  description String?   @db.Text
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt  DateTime? @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  assignments MembershipRole[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model RolePermission {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  roleId       String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect @default(ALLOW)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId, permissionId])
}

model MembershipRole {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  membershipId String    @db.Uuid
  roleId       String    @db.Uuid
  branchId     String?   @db.Uuid
  validFrom    DateTime? @db.Timestamptz(6)
  validUntil   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch     Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId])
  @@index([tenantId, roleId])
  @@index([tenantId, branchId])
}

model MembershipPermissionGrant {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  membershipId String           @db.Uuid
  permissionId String           @db.Uuid
  branchId     String?          @db.Uuid
  effect       PermissionEffect
  reason       String?          @db.VarChar(500)
  validFrom    DateTime?        @db.Timestamptz(6)
  validUntil   DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  branch     Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId])
  @@index([tenantId, permissionId])
  @@index([tenantId, branchId])
}

model Patient {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  patientNumber   String        @db.VarChar(100)
  status          PatientStatus @default(ACTIVE)
  givenName       String        @db.VarChar(120)
  middleName      String?       @db.VarChar(120)
  familyName      String        @db.VarChar(120)
  dateOfBirth     DateTime?     @db.Date
  sex             String?       @db.VarChar(50)
  phone           String?       @db.VarChar(50)
  email           String?       @db.VarChar(320)
  normalizedPhone String?       @db.VarChar(50)
  normalizedEmail String?       @db.VarChar(320)
  address         Json?
  guardianData    Json?
  consentData     Json?
  photoObjectKey  String?       @db.VarChar(1000)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  archivedAt      DateTime?     @db.Timestamptz(6)

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accessAccounts   PatientAccess[]
  appointments     Appointment[]
  encounters       Encounter[]
  diagnosticOrders DiagnosticOrder[]
  prescriptions    Prescription[]
  invoices         Invoice[]
  documents        DocumentRecord[]
  notifications    Notification[]
  identifiers      PatientIdentifier[]
  queueEntries     QueueEntry[]
  diagnoses        EncounterDiagnosis[]
  allergies        PatientAllergy[]
  observations     ClinicalObservation[]
  dispenses        Dispense[]

  @@unique([tenantId, patientNumber])
  @@index([tenantId, status])
  @@index([tenantId, familyName, givenName])
  @@index([tenantId, normalizedPhone])
  @@index([tenantId, normalizedEmail])
}

model PatientAccess {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @db.Uuid
  identityId   String   @db.Uuid
  relationship String   @default("self") @db.VarChar(80)
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([patientId, identityId])
  @@index([identityId, isActive])
}

model StaffProfile {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  membershipId   String      @unique @db.Uuid
  branchId       String?     @db.Uuid
  employeeNumber String      @db.VarChar(100)
  staffType      String      @db.VarChar(80)
  status         StaffStatus @default(ACTIVE)
  title          String?     @db.VarChar(120)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  branch     Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  doctor     DoctorProfile?

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, staffType, status])
}

model DoctorProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  staffProfileId     String   @unique @db.Uuid
  departmentId       String?  @db.Uuid
  registrationNumber String?  @db.VarChar(150)
  specialty          String?  @db.VarChar(200)
  qualifications     String?  @db.Text
  biography          String?  @db.Text
  contactPhone       String?  @db.VarChar(80)
  profileImageData   String?  @db.Text
  durationMinutes    Int      @default(15)
  publiclyBookable   Boolean  @default(false)
  signatureObjectKey String?  @db.VarChar(1000)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staffProfile      StaffProfile        @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  department        Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  availabilityRules AvailabilityRule[]
  appointments      Appointment[]
  encounters        Encounter[]
  prescriptions     Prescription[]
  services          ServiceDefinition[]
  sittings          DoctorSitting[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId, publiclyBookable])
  @@index([tenantId, departmentId])
}

/// A hospital policy or patient-facing content document. The live text lives
/// here; every publish snapshots it into PolicyDocumentVersion so an earlier
/// wording can always be produced for an audit.
model PolicyDocument {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  organizationId String       @db.Uuid
  code           String       @db.VarChar(100)
  title          String       @db.VarChar(250)
  category       String       @db.VarChar(80)
  summary        String?      @db.VarChar(500)
  body           String       @db.Text
  status         PolicyStatus @default(DRAFT)
  version        Int          @default(1)
  effectiveFrom  DateTime?    @db.Timestamptz(6)
  publishedAt    DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  archivedAt     DateTime?    @db.Timestamptz(6)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     PolicyDocumentVersion[]

  @@unique([tenantId, code])
  @@index([tenantId, organizationId, status])
}

/// Immutable snapshot of a policy as it was published.
model PolicyDocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  policyId      String   @db.Uuid
  version       Int
  title         String   @db.VarChar(250)
  body          String   @db.Text
  effectiveFrom DateTime? @db.Timestamptz(6)
  publishedAt   DateTime @default(now()) @db.Timestamptz(6)
  publishedById String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy PolicyDocument @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([tenantId, policyId])
}

model ServiceDefinition {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  branchId         String?          @db.Uuid
  doctorId         String?          @db.Uuid
  /// Desk that operates this service when no single person owns it.
  handlerWorkspace WorkspaceCode?
  /// Specific staff member who operates this service, when one is named.
  handlerMembershipId String?       @db.Uuid
  code             String           @db.VarChar(100)
  name             String           @db.VarChar(250)
  category         String           @db.VarChar(100)
  description      String?          @db.Text
  durationMinutes  Int              @default(15)
  priceMinorUnits  Int?
  currencyCode     String           @default("PKR") @db.Char(3)
  publiclyBookable Boolean          @default(false)
  consultationMode ConsultationMode @default(IN_PERSON)
  /// Who may set this service price. DOCTOR is only valid on a doctor-linked service.
  billingOwner     ServiceBillingOwner @default(HOSPITAL)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  handlerMembership TenantMembership?  @relation("ServiceHandler", fields: [handlerMembershipId], references: [id], onDelete: SetNull)
  doctor            DoctorProfile?     @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  availabilityRules AvailabilityRule[]
  appointments      Appointment[]
  invoiceLines      InvoiceLine[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId, isActive])
  @@index([tenantId, handlerMembershipId, isActive])
  @@index([tenantId, doctorId, isActive])
}

model AvailabilityRule {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  doctorId     String    @db.Uuid
  branchId     String    @db.Uuid
  serviceId    String?   @db.Uuid
  weekday      Int
  startsMinute Int
  endsMinute   Int
  capacity     Int       @default(1)
  validFrom    DateTime  @db.Date
  validUntil   DateTime? @db.Date
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch  Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service ServiceDefinition? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, doctorId, weekday])
  @@index([tenantId, branchId, isActive])
}

/// A doctor's actual sitting hours for one business date at one branch.
/// The hospital roster (AvailabilityRule) is the expected arrival window;
/// a sitting recorded here overrides it when slots are generated.
model DoctorSitting {
  id                         String              @id @default(uuid()) @db.Uuid
  tenantId                   String              @db.Uuid
  doctorId                   String              @db.Uuid
  branchId                   String              @db.Uuid
  businessDate               DateTime            @db.Date
  startsMinute               Int
  endsMinute                 Int
  averageConsultationMinutes Int                 @default(15)
  roomLabel                  String?             @db.VarChar(120)
  status                     DoctorSittingStatus @default(PLANNED)
  actualStartedAt            DateTime?           @db.Timestamptz(6)
  actualEndedAt              DateTime?           @db.Timestamptz(6)
  createdAt                  DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctorId, branchId, businessDate])
  @@index([tenantId, branchId, businessDate])
  @@index([tenantId, doctorId, businessDate])
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  patientId          String            @db.Uuid
  doctorId           String?           @db.Uuid
  branchId           String            @db.Uuid
  serviceId          String?           @db.Uuid
  status             AppointmentStatus @default(PENDING)
  consultationMode   ConsultationMode  @default(IN_PERSON)
  source             String            @db.VarChar(80)
  reason             String?           @db.Text
  startsAt           DateTime          @db.Timestamptz(6)
  endsAt             DateTime          @db.Timestamptz(6)
  checkedInAt        DateTime?         @db.Timestamptz(6)
  tokenNumber        Int?
  queueStatus        String?           @db.VarChar(80)
  cancellationReason String?           @db.VarChar(1000)
  cancelledAt        DateTime?         @db.Timestamptz(6)
  idempotencyKey     String?           @db.VarChar(160)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor           DoctorProfile?     @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service          ServiceDefinition? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  encounter        Encounter?
  queueEntry       QueueEntry?
  videoCallSession VideoCallSession?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, startsAt, status])
  @@index([tenantId, doctorId, startsAt])
  @@index([tenantId, patientId, startsAt])
}

model VideoCallSession {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  appointmentId   String          @unique @db.Uuid
  status          VideoCallStatus @default(WAITING)
  patientJoinedAt DateTime?       @db.Timestamptz(6)
  doctorJoinedAt  DateTime?       @db.Timestamptz(6)
  startedAt       DateTime?       @db.Timestamptz(6)
  endedAt         DateTime?       @db.Timestamptz(6)
  expiresAt       DateTime        @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointment Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  signals     VideoCallSignal[]

  @@index([tenantId, status, expiresAt])
}

model VideoCallSignal {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @db.Uuid
  senderRole String   @db.VarChar(20)
  signalType String   @db.VarChar(20)
  payload    Json
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime @db.Timestamptz(6)

  session VideoCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

model Encounter {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  patientId     String          @db.Uuid
  appointmentId String?         @unique @db.Uuid
  doctorId      String?         @db.Uuid
  branchId      String          @db.Uuid
  status        EncounterStatus @default(PLANNED)
  reason        String?         @db.Text
  clinicalData  Json?
  signedAt      DateTime?       @db.Timestamptz(6)
  releasedAt    DateTime?       @db.Timestamptz(6)
  version       Int             @default(1)
  startedAt     DateTime?       @db.Timestamptz(6)
  endedAt       DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient          Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment      Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor           DoctorProfile?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  branch           Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  diagnosticOrders DiagnosticOrder[]
  prescriptions    Prescription[]
  notes            EncounterNote[]
  diagnoses        EncounterDiagnosis[]
  observations     ClinicalObservation[]

  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, doctorId, status])
  @@index([tenantId, branchId, status])
}

model DiagnosticOrder {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.Uuid
  branchId              String           @db.Uuid
  accessionNumber       String?          @db.VarChar(120)
  patientId             String           @db.Uuid
  /// Null for a walk-in ordered at reception, which has no clinical encounter.
  encounterId           String?          @db.Uuid
  orderedByMembershipId String           @db.Uuid
  type                  DiagnosticType
  status                DiagnosticStatus @default(DRAFT)
  priority              String           @default("routine") @db.VarChar(50)
  code                  String           @db.VarChar(120)
  name                  String           @db.VarChar(300)
  specimenOrBodySite    String?          @db.VarChar(200)
  clinicalReason        String?          @db.Text
  orderedAt             DateTime?        @db.Timestamptz(6)
  completedAt           DateTime?        @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(6)

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter?           @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  branch    Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  results   DiagnosticResult[]
  specimens DiagnosticSpecimen[]

  @@unique([tenantId, accessionNumber])
  @@index([tenantId, type, status, createdAt])
  @@index([tenantId, patientId])
  @@index([tenantId, branchId, type, status, createdAt])
}

model DiagnosticResult {
  id                      String                 @id @default(uuid()) @db.Uuid
  orderId                 String                 @db.Uuid
  tenantId                String                 @db.Uuid
  status                  DiagnosticResultStatus @default(PRELIMINARY)
  resultData              Json?
  reportText              String?                @db.Text
  critical                Boolean                @default(false)
  criticalNotes           String?                @db.Text
  performedByMembershipId String?                @db.Uuid
  verifiedByMembershipId  String?                @db.Uuid
  releasedByMembershipId  String?                @db.Uuid
  verifiedAt              DateTime?              @db.Timestamptz(6)
  releasedAt              DateTime?              @db.Timestamptz(6)
  acknowledgedAt          DateTime?              @db.Timestamptz(6)
  correctionReason        String?                @db.VarChar(1000)
  version                 Int                    @default(1)
  createdAt               DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(6)

  order  DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([critical, releasedAt])
  @@index([tenantId, status, releasedAt])
}

model Medication {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String   @db.VarChar(120)
  genericName String   @db.VarChar(300)
  brandName   String?  @db.VarChar(300)
  strength    String?  @db.VarChar(150)
  dosageForm  String?  @db.VarChar(150)
  unit        String   @db.VarChar(80)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryBatches  InventoryBatch[]
  prescriptionItems PrescriptionItem[]
  stockMovements    StockMovement[]
  dispenseItems     DispenseItem[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model InventoryBatch {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  branchId     String               @db.Uuid
  medicationId String               @db.Uuid
  batchNumber  String               @db.VarChar(150)
  expiryDate   DateTime             @db.Date
  quantity     Decimal              @default(0) @db.Decimal(18, 4)
  status       InventoryBatchStatus @default(AVAILABLE)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  medication     Medication      @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]
  dispenseItems  DispenseItem[]

  @@unique([tenantId, branchId, medicationId, batchNumber])
  @@index([tenantId, branchId, status, expiryDate])
}

model Prescription {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  patientId    String             @db.Uuid
  encounterId  String             @db.Uuid
  doctorId     String             @db.Uuid
  status       PrescriptionStatus @default(DRAFT)
  instructions String?            @db.Text
  prescribedAt DateTime?          @db.Timestamptz(6)
  signedAt     DateTime?          @db.Timestamptz(6)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter          @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  doctor    DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  items     PrescriptionItem[]
  dispenses Dispense[]

  @@index([tenantId, patientId, status])
  @@index([tenantId, doctorId, createdAt])
}

model PrescriptionItem {
  id             String   @id @default(uuid()) @db.Uuid
  prescriptionId String   @db.Uuid
  medicationId   String   @db.Uuid
  dose           String   @db.VarChar(250)
  route          String?  @db.VarChar(150)
  frequency      String   @db.VarChar(250)
  duration       String?  @db.VarChar(200)
  quantity       Decimal? @db.Decimal(18, 4)
  instructions   String?  @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  prescription  Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication    Medication     @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  dispenseItems DispenseItem[]

  @@index([prescriptionId])
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  patientId     String        @db.Uuid
  branchId      String        @db.Uuid
  invoiceNumber String        @db.VarChar(120)
  status        InvoiceStatus @default(DRAFT)
  currencyCode  String        @default("PKR") @db.Char(3)
  subtotalMinor Int           @default(0)
  discountMinor Int           @default(0)
  totalMinor    Int           @default(0)
  paidMinor     Int           @default(0)
  issuedAt      DateTime?     @db.Timestamptz(6)
  dueAt         DateTime?     @db.Timestamptz(6)
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments Payment[]
  refunds  Refund[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, branchId, status, createdAt])
  @@index([tenantId, patientId])
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @db.Uuid
  serviceId      String?  @db.Uuid
  description    String   @db.VarChar(500)
  quantity       Decimal  @default(1) @db.Decimal(18, 4)
  unitPriceMinor Int
  totalMinor     Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  invoice Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service ServiceDefinition? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @db.Uuid
  invoiceId              String        @db.Uuid
  receivedByMembershipId String        @db.Uuid
  status                 PaymentStatus @default(PENDING)
  method                 String        @db.VarChar(80)
  amountMinor            Int
  currencyCode           String        @default("PKR") @db.Char(3)
  reference              String?       @db.VarChar(250)
  completedAt            DateTime?     @db.Timestamptz(6)
  reversedAt             DateTime?     @db.Timestamptz(6)
  reversalReason         String?       @db.VarChar(1000)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([tenantId, invoiceId, status])
}

model StoredObject {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  objectKey   String             @unique @db.VarChar(1000)
  status      StoredObjectStatus @default(PENDING)
  contentType String             @db.VarChar(250)
  sizeBytes   BigInt
  checksum    String?            @db.VarChar(200)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents DocumentRecord[]

  @@index([tenantId, status])
}

model DocumentRecord {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  patientId  String?        @db.Uuid
  objectId   String         @db.Uuid
  category   String         @db.VarChar(100)
  title      String         @db.VarChar(300)
  status     DocumentStatus @default(DRAFT)
  releasedAt DateTime?      @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(6)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  object  StoredObject @relation(fields: [objectId], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, status])
}

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  identityId    String?             @db.Uuid
  patientId     String?             @db.Uuid
  channel       NotificationChannel
  status        NotificationStatus  @default(PENDING)
  templateCode  String              @db.VarChar(160)
  destination   String?             @db.VarChar(500)
  payload       Json
  scheduledAt   DateTime?           @db.Timestamptz(6)
  sentAt        DateTime?           @db.Timestamptz(6)
  deliveredAt   DateTime?           @db.Timestamptz(6)
  failedAt      DateTime?           @db.Timestamptz(6)
  failureReason String?             @db.Text
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)

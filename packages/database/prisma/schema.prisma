generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                     String                      @id @default(uuid()) @db.Uuid
  slug                   String                      @unique @db.VarChar(120)
  displayName            String                      @db.VarChar(200)
  legalName              String?                     @db.VarChar(250)
  domain                 String?                     @unique @db.VarChar(250)
  status                 TenantStatus                @default(DRAFT)
  defaultLocale          String                      @default("en") @db.VarChar(20)
  secondaryLocale        String?                     @default("ur") @db.VarChar(20)
  defaultTimezone        String                      @default("Asia/Karachi") @db.VarChar(100)
  defaultCurrencyCode    String                      @default("PKR") @db.Char(3)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(6)
  archivedAt             DateTime?                   @db.Timestamptz(6)
  /// Atomically incremented (never read-then-write) to hand out gapless,
  /// unique invoice numbers per tenant — see server/finance/invoice-numbering.ts.
  nextInvoiceNumber      Int                         @default(1)
  appointments           Appointment[]
  auditEvents            AuditEvent[]
  sessions               AuthSession[]
  availabilityRules      AvailabilityRule[]
  branches               Branch[]
  CarePlan               CarePlan[]
  CarePlanAlert          CarePlanAlert[]
  CarePlanTask           CarePlanTask[]
  CarePlanTemplate       CarePlanTemplate[]
  CaregiverInvitation    CaregiverInvitation[]
  clinicalObservations   ClinicalObservation[]
  ClinicalReferral       ClinicalReferral[]
  departments            Department[]
  deviceRegistrations    DeviceRegistration[]
  diagnosticOrders       DiagnosticOrder[]
  diagnosticResults      DiagnosticResult[]
  diagnosticSpecimens    DiagnosticSpecimen[]
  dispenses              Dispense[]
  doctorProfiles         DoctorProfile[]
  doctorSittings         DoctorSitting[]
  documentAccessTokens   DocumentAccessToken[]
  documents              DocumentRecord[]
  documentUploadSessions DocumentUploadSession[]
  DrainLog               DrainLog[]
  EducationAssignment    EducationAssignment[]
  EducationContent       EducationContent[]
  encounters             Encounter[]
  encounterDiagnoses     EncounterDiagnosis[]
  encounterNotes         EncounterNote[]
  idempotencyRecords     IdempotencyRecord[]
  inventoryBatches       InventoryBatch[]
  invoices               Invoice[]
  medications            Medication[]
  permissionGrants       MembershipPermissionGrant[]
  roleAssignments        MembershipRole[]
  notifications          Notification[]
  oneTimeTokens          OneTimeToken[]
  organizations          Organization[]
  outboxEvents           OutboxEvent[]
  patients               Patient[]
  patientAllergies       PatientAllergy[]
  PatientDrain           PatientDrain[]
  patientIdentifiers     PatientIdentifier[]
  payments               Payment[]
  paymentAccounts        PaymentAccount[]
  pharmacyReturns        PharmacyReturn[]
  policies               PolicyDocument[]
  policyVersions         PolicyDocumentVersion[]
  prescriptions          Prescription[]
  purchaseReceipts       PurchaseReceipt[]
  queues                 Queue[]
  queueEntries           QueueEntry[]
  refunds                Refund[]
  roles                  Role[]
  rolePermissions        RolePermission[]
  services               ServiceDefinition[]
  serviceFeeHistory      ServiceFeeHistory[]
  staffProfiles          StaffProfile[]
  stockMovements         StockMovement[]
  storedObjects          StoredObject[]
  suppliers              Supplier[]
  supportAccess          SupportAccessGrant[]
  ClinicalAcknowledgement ClinicalAcknowledgement[]
  SymptomLog             SymptomLog[]
  TherapyAssessment      TherapyAssessment[]
  ExerciseDefinition     ExerciseDefinition[]
  TherapySession         TherapySession[]
  NutritionAssessment    NutritionAssessment[]
  NutritionPlan          NutritionPlan[]
  NutritionPlanItem      NutritionPlanItem[]
  AlertRule              AlertRule[]
  PatientAlertRule       PatientAlertRule[]
  AlertEvent             AlertEvent[]
  AlertRota              AlertRota[]
  AlertEscalation        AlertEscalation[]
  doctorFeeRequests      DoctorFeeRequest[]
  entitlements           TenantEntitlement[]

  invitations            TenantInvitation[]
  memberships            TenantMembership[]
  onboardingState        TenantOnboardingState?
  picklistEntries        TenantPicklistEntry[]
  subscription           TenantSubscription?
  videoCallSessions      VideoCallSession[]

  @@index([status])
}

/// Free-text options staff add mid-workflow — a chief complaint, a diagnosis,
/// a lab or radiology order, a consultation room — that are not in the seeded
/// starter list. These belong to the hospital, not to one browser: a complaint
/// typed at reception has to appear for the doctor on the next workstation, and
/// a room added on a tablet has to exist for the whole queue. Held here rather
/// than in localStorage, per docs/architecture/client-storage.md.
model TenantPicklistEntry {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @db.Uuid
  kind                  TenantPicklistKind
  label                 String             @db.VarChar(250)
  /// Lower-cased, whitespace-collapsed `label`. Carries the uniqueness
  /// constraint so "Chest Pain" and "chest  pain" cannot both be added.
  normalizedLabel       String             @db.VarChar(250)
  code                  String?            @db.VarChar(100)
  /// Kind-specific extras: `certainty` for a diagnosis, `priority` for an
  /// order, `category` for a room.
  metadata              Json?
  createdByMembershipId String?            @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, normalizedLabel])
  @@index([tenantId, kind])
}

/// Server-held onboarding wizard progress, so a tenant owner who starts
/// setup on one device can resume on another — never tracked client-side.
model TenantOnboardingState {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @unique @db.Uuid
  currentStep String   @db.VarChar(50)
  /// Map of stepCode -> { status, startedAt?, completedAt?, skippedAt? }
  steps       Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  code               String             @db.VarChar(80)
  displayName        String             @db.VarChar(200)
  legalName          String?            @db.VarChar(250)
  registrationNumber String?            @db.VarChar(120)
  email              String?            @db.VarChar(320)
  phone              String?            @db.VarChar(50)
  website            String?            @db.VarChar(500)
  logoObjectKey      String?            @db.VarChar(1000)
  status             OrganizationStatus @default(ACTIVE)
  settings           Json?
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  archivedAt         DateTime?          @db.Timestamptz(6)
  doctorFeeAuthority DoctorFeeAuthority @default(HOSPITAL)
  branches           Branch[]
  departments        Department[]
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  policies           PolicyDocument[]
  memberships        TenantMembership[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model Department {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  organizationId String          @db.Uuid
  branchId       String?         @db.Uuid
  code           String          @db.VarChar(80)
  name           String          @db.VarChar(200)
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  archivedAt     DateTime?       @db.Timestamptz(6)
  branch         Branch?         @relation(fields: [branchId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  doctors        DoctorProfile[]

  @@unique([tenantId, code])
  @@index([tenantId, organizationId, isActive])
  @@index([branchId])
  @@index([organizationId])
}

model Branch {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @db.Uuid
  organizationId     String                      @db.Uuid
  code               String                      @db.VarChar(80)
  name               String                      @db.VarChar(200)
  status             BranchStatus                @default(ACTIVE)
  isMainBranch       Boolean                     @default(false)
  email              String?                     @db.VarChar(320)
  phone              String?                     @db.VarChar(50)
  timezone           String                      @default("Asia/Karachi") @db.VarChar(100)
  currencyCode       String                      @default("PKR") @db.Char(3)
  address            Json?
  createdAt          DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(6)
  archivedAt         DateTime?                   @db.Timestamptz(6)
  appointments       Appointment[]
  availabilityRules  AvailabilityRule[]
  organization       Organization                @relation(fields: [organizationId], references: [id])
  tenant             Tenant                      @relation(fields: [tenantId], references: [id])
  departments        Department[]
  diagnosticOrders   DiagnosticOrder[]
  dispenses          Dispense[]
  doctorSittings     DoctorSitting[]
  encounters         Encounter[]
  inventoryBatches   InventoryBatch[]
  invoices           Invoice[]
  permissionGrants   MembershipPermissionGrant[]
  roleAssignments    MembershipRole[]
  pharmacyReturns    PharmacyReturn[]
  purchaseReceipts   PurchaseReceipt[]
  queues             Queue[]
  services           ServiceDefinition[]
  staffProfiles      StaffProfile[]
  stockMovements     StockMovement[]
  primaryMemberships TenantMembership[]          @relation("MembershipPrimaryBranch")
  doctorFeeRequests  DoctorFeeRequest[]

  @@unique([tenantId, code])
  @@unique([tenantId, organizationId], map: "Branch_single_main_per_organization", where: raw("(\"isMainBranch\" AND (\"archivedAt\" IS NULL))"))
  @@index([tenantId, organizationId, status])
  @@index([tenantId, isMainBranch])
  @@index([organizationId])
}

model Identity {
  id                      String                @id @default(uuid()) @db.Uuid
  email                   String                @db.VarChar(320)
  normalizedEmail         String                @unique @db.VarChar(320)
  phone                   String?               @db.VarChar(50)
  normalizedPhone         String?               @unique @db.VarChar(50)
  passwordHash            String?               @db.VarChar(500)
  status                  IdentityStatus        @default(INVITED)
  isPlatformAdministrator Boolean               @default(false)
  platformPermissionCodes String[]              @default([])
  emailVerifiedAt         DateTime?             @db.Timestamptz(6)
  phoneVerifiedAt         DateTime?             @db.Timestamptz(6)
  failedLoginCount        Int                   @default(0)
  lockedUntil             DateTime?             @db.Timestamptz(6)
  passwordChangedAt       DateTime?             @db.Timestamptz(6)
  lastAuthenticatedAt     DateTime?             @db.Timestamptz(6)
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(6)
  archivedAt              DateTime?             @db.Timestamptz(6)
  mustChangePassword      Boolean               @default(false)
  sessions                AuthSession[]
  CarePlan                CarePlan[]
  CarePlanTask            CarePlanTask[]
  CaregiverInvitation     CaregiverInvitation[]
  deviceRegistrations     DeviceRegistration[]
  EducationCompletion     EducationCompletion[]
  mfaCredentials          MfaCredential[]
  notifications           Notification[]
  oneTimeTokens           OneTimeToken[]
  patientAccess           PatientAccess[]
  SymptomLog              SymptomLog[]
  memberships             TenantMembership[]

  @@index([status])
}

model TenantMembership {
  id                  String                      @id @default(uuid()) @db.Uuid
  tenantId            String                      @db.Uuid
  identityId          String                      @db.Uuid
  organizationId      String                      @db.Uuid
  primaryBranchId     String?                     @db.Uuid
  displayName         String                      @db.VarChar(250)
  photoObjectKey      String?                     @db.VarChar(1000)
  status              MembershipStatus            @default(INVITED)
  workspaceCodes      WorkspaceCode[]             @default([])
  primaryWorkspace    WorkspaceCode?
  preferredLocale     String                      @default("en") @db.VarChar(20)
  createdAt           DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(6)
  archivedAt          DateTime?                   @db.Timestamptz(6)
  sessions            AuthSession[]
  CarePlanAlert       CarePlanAlert[]
  CarePlanTemplate    CarePlanTemplate[]
  ClinicalAcknowledgement ClinicalAcknowledgement[]
  EducationAssignment EducationAssignment[]
  directGrants        MembershipPermissionGrant[]
  roles               MembershipRole[]
  PatientDrain        PatientDrain[]
  AlertRuleCreated    AlertRule[]
  AlertEventsAcknowledged AlertEvent[]         @relation("AlertEventAcknowledgedBy")
  AlertEventsResolved AlertEvent[]         @relation("AlertEventResolvedBy")
  AlertRotaPrimary    AlertRota[]          @relation("AlertRotaPrimary")
  AlertRotaEscalation AlertRota[]          @relation("AlertRotaEscalation")
  AlertEscalationsTarget AlertEscalation[]
  handledServices     ServiceDefinition[]         @relation("ServiceHandler")
  feeRequestsSubmitted DoctorFeeRequest[]         @relation("FeeRequestRequester")
  feeRequestsReviewed  DoctorFeeRequest[]         @relation("FeeRequestReviewer")
  staffProfile        StaffProfile?
  identity            Identity                    @relation(fields: [identityId], references: [id])
  organization        Organization                @relation(fields: [organizationId], references: [id])
  primaryBranch       Branch?                     @relation("MembershipPrimaryBranch", fields: [primaryBranchId], references: [id])
  tenant              Tenant                      @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, identityId])
  @@index([tenantId, status])
  @@index([identityId, status])
  @@index([organizationId])
  @@index([primaryBranchId])
}

model AuthSession {
  id                 String            @id @default(uuid()) @db.Uuid
  identityId         String            @db.Uuid
  membershipId       String?           @db.Uuid
  tenantId           String?           @db.Uuid
  organizationId     String?           @db.Uuid
  branchId           String?           @db.Uuid
  workspace          WorkspaceCode?
  tokenHash          String            @unique @db.Char(64)
  status             SessionStatus     @default(ACTIVE)
  sourceApplication  String            @db.VarChar(50)
  deviceId           String?           @db.VarChar(200)
  deviceName         String?           @db.VarChar(200)
  ipAddress          String?           @db.VarChar(100)
  userAgent          String?
  mfaVerifiedAt      DateTime?         @db.Timestamptz(6)
  lastSeenAt         DateTime          @default(now()) @db.Timestamptz(6)
  expiresAt          DateTime          @db.Timestamptz(6)
  revokedAt          DateTime?         @db.Timestamptz(6)
  revocationReason   String?           @db.VarChar(500)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  refreshExpiresAt   DateTime?         @db.Timestamptz(6)
  refreshTokenHash   String?           @unique @db.Char(64)
  patientId          String?           @db.Uuid
  actingRelationship String?           @db.VarChar(80)
  identity           Identity          @relation(fields: [identityId], references: [id], onDelete: Cascade)
  membership         TenantMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([identityId, status])
  @@index([tenantId, membershipId, status])
  @@index([expiresAt])
  @@index([membershipId])
}

model OneTimeToken {
  id         String       @id @default(uuid()) @db.Uuid
  identityId String       @db.Uuid
  tenantId   String?      @db.Uuid
  purpose    TokenPurpose
  status     TokenStatus  @default(ACTIVE)
  tokenHash  String       @unique @db.Char(64)
  expiresAt  DateTime     @db.Timestamptz(6)
  consumedAt DateTime?    @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  identity   Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)
  tenant     Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([identityId, purpose, status])
  @@index([expiresAt])
  @@index([tenantId])
}

model MfaCredential {
  id                 String    @id @default(uuid()) @db.Uuid
  identityId         String    @db.Uuid
  status             MfaStatus @default(PENDING)
  label              String?   @db.VarChar(200)
  secretCiphertext   String
  recoveryCodeHashes String[]  @default([])
  verifiedAt         DateTime? @db.Timestamptz(6)
  lastUsedAt         DateTime? @db.Timestamptz(6)
  revokedAt          DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  identity           Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, status])
}

model TenantInvitation {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.Uuid
  normalizedEmail       String           @db.VarChar(320)
  displayName           String           @db.VarChar(250)
  organizationId        String           @db.Uuid
  primaryBranchId       String?          @db.Uuid
  workspaceCodes        WorkspaceCode[]  @default([])
  invitedByMembershipId String           @db.Uuid
  acceptedIdentityId    String?          @db.Uuid
  tokenId               String?          @db.Uuid
  status                MembershipStatus @default(INVITED)
  expiresAt             DateTime         @db.Timestamptz(6)
  acceptedAt            DateTime?        @db.Timestamptz(6)
  revokedAt             DateTime?        @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, normalizedEmail, status])
  @@index([expiresAt])
}

model Permission {
  id              String                      @id @default(uuid()) @db.Uuid
  code            String                      @unique @db.VarChar(160)
  category        String                      @db.VarChar(100)
  label           String                      @db.VarChar(200)
  description     String?
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(6)
  directGrants    MembershipPermissionGrant[]
  rolePermissions RolePermission[]
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  code        String           @db.VarChar(120)
  name        String           @db.VarChar(200)
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  archivedAt  DateTime?        @db.Timestamptz(6)
  assignments MembershipRole[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model RolePermission {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  roleId       String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect @default(ALLOW)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model MembershipRole {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  membershipId String           @db.Uuid
  roleId       String           @db.Uuid
  branchId     String?          @db.Uuid
  validFrom    DateTime?        @db.Timestamptz(6)
  validUntil   DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId])
  @@index([tenantId, roleId])
  @@index([tenantId, branchId])
  @@index([membershipId])
  @@index([roleId])
  @@index([branchId])
}

model MembershipPermissionGrant {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  membershipId String           @db.Uuid
  permissionId String           @db.Uuid
  branchId     String?          @db.Uuid
  effect       PermissionEffect
  reason       String?          @db.VarChar(500)
  validFrom    DateTime?        @db.Timestamptz(6)
  validUntil   DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId])
  @@index([tenantId, permissionId])
  @@index([tenantId, branchId])
  @@index([membershipId])
  @@index([permissionId])
  @@index([branchId])
}

model Patient {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @db.Uuid
  patientNumber       String                @db.VarChar(100)
  status              PatientStatus         @default(ACTIVE)
  givenName           String                @db.VarChar(120)
  middleName          String?               @db.VarChar(120)
  familyName          String                @db.VarChar(120)
  dateOfBirth         DateTime?             @db.Date
  sex                 String?               @db.VarChar(50)
  phone               String?               @db.VarChar(50)
  email               String?               @db.VarChar(320)
  address             Json?
  guardianData        Json?
  consentData         Json?
  photoObjectKey      String?               @db.VarChar(1000)
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)
  archivedAt          DateTime?             @db.Timestamptz(6)
  normalizedEmail     String?               @db.VarChar(320)
  normalizedPhone     String?               @db.VarChar(50)
  photoContentType    String?               @db.VarChar(100)
  appointments        Appointment[]
  CarePlan            CarePlan[]
  CarePlanAlert       CarePlanAlert[]
  CaregiverInvitation CaregiverInvitation[]
  observations        ClinicalObservation[]
  ClinicalReferral    ClinicalReferral[]
  diagnosticOrders    DiagnosticOrder[]
  dispenses           Dispense[]
  documents           DocumentRecord[]
  DrainLog            DrainLog[]
  EducationAssignment EducationAssignment[]
  encounters          Encounter[]
  diagnoses           EncounterDiagnosis[]
  invoices            Invoice[]
  notifications       Notification[]
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  accessAccounts      PatientAccess[]
  allergies           PatientAllergy[]
  PatientDrain         PatientDrain[]
  identifiers          PatientIdentifier[]
  pharmacyReturns      PharmacyReturn[]
  prescriptions        Prescription[]
  queueEntries         QueueEntry[]
  ClinicalAcknowledgement ClinicalAcknowledgement[]
  SymptomLog           SymptomLog[]
  TherapyAssessment    TherapyAssessment[]
  TherapySession       TherapySession[]
  NutritionAssessment  NutritionAssessment[]
  NutritionPlan        NutritionPlan[]
  PatientAlertRule     PatientAlertRule[]
  AlertEvent           AlertEvent[]

  @@unique([tenantId, patientNumber])
  @@index([tenantId, status])
  @@index([tenantId, familyName, givenName])
  @@index([tenantId, normalizedPhone])
  @@index([tenantId, normalizedEmail])
}

model PatientAccess {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @db.Uuid
  identityId   String    @db.Uuid
  relationship String    @default("self") @db.VarChar(80)
  isPrimary    Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  permissions  String[]  @default(["observations.write", "careplan.complete"])
  invitedBy    String?   @db.Uuid
  expiresAt    DateTime? @db.Timestamptz(6)
  referralId   String?   @db.Uuid
  accessReason String?   @db.VarChar(200)
  identity     Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, identityId])
  @@index([identityId, isActive])
  @@index([referralId])
}


model StaffProfile {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  membershipId          String                @unique @db.Uuid
  branchId              String?               @db.Uuid
  employeeNumber        String                @db.VarChar(100)
  staffType             String                @db.VarChar(80)
  status                StaffStatus           @default(ACTIVE)
  title                 String?               @db.VarChar(120)
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(6)
  therapistCarePlans    CarePlan[]            @relation("CarePlanAssignedTherapist")
  nutritionistCarePlans CarePlan[]            @relation("CarePlanAssignedNutritionist")
  ClinicalReferral      ClinicalReferral[]
  TherapyAssessment     TherapyAssessment[]
  TherapySession        TherapySession[]
  NutritionAssessment   NutritionAssessment[]
  NutritionPlan         NutritionPlan[]
  doctor                DoctorProfile?
  branch                Branch?               @relation(fields: [branchId], references: [id])
  membership            TenantMembership      @relation(fields: [membershipId], references: [id])
  tenant                Tenant                @relation(fields: [tenantId], references: [id])



  @@unique([tenantId, employeeNumber])
  @@index([tenantId, staffType, status])
  @@index([branchId])
}

model DoctorProfile {
  id                       String              @id @default(uuid()) @db.Uuid
  tenantId                 String              @db.Uuid
  staffProfileId           String              @unique @db.Uuid
  registrationNumber       String?             @db.VarChar(150)
  specialty                String?             @db.VarChar(200)
  durationMinutes          Int                 @default(15)
  publiclyBookable         Boolean             @default(false)
  signatureObjectKey       String?             @db.VarChar(1000)
  createdAt                DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(6)
  qualifications           String?
  biography                String?
  contactPhone             String?             @db.VarChar(80)
  profileImageData         String?
  departmentId             String?             @db.Uuid
  /// When true, this clinician's clinical notes cannot be self-signed —
  /// they save as DRAFT and require supervisorDoctorId to countersign.
  requiresCountersignature Boolean             @default(false)
  supervisorDoctorId       String?             @db.Uuid
  /// The clinician's signature image, as a data URL, stored the same way as
  /// `profileImageData`. This signs clinical notes and prescriptions, so it
  /// must follow the doctor to every workstation and must not outlive their
  /// session in a shared browser.
  signatureImageData       String?
  appointments             Appointment[]
  availabilityRules        AvailabilityRule[]
  CarePlan                 CarePlan[]
  ClinicalReferral         ClinicalReferral[]
  department               Department?         @relation(fields: [departmentId], references: [id])
  staffProfile             StaffProfile        @relation(fields: [staffProfileId], references: [id])
  supervisor               DoctorProfile?      @relation("DoctorSupervision", fields: [supervisorDoctorId], references: [id])
  supervisees              DoctorProfile[]     @relation("DoctorSupervision")
  tenant                   Tenant              @relation(fields: [tenantId], references: [id])
  sittings                 DoctorSitting[]
  encounters               Encounter[]
  feeRequests              DoctorFeeRequest[]
  prescriptions            Prescription[]
  services                 ServiceDefinition[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId, publiclyBookable])
  @@index([tenantId, departmentId])
  @@index([tenantId, supervisorDoctorId])
  @@index([departmentId])
  @@index([supervisorDoctorId])
}

/// A hospital policy or patient-facing content document. The live text lives
/// here; every publish snapshots it into PolicyDocumentVersion so an earlier
/// wording can always be produced for an audit.
model PolicyDocument {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @db.Uuid
  organizationId String                  @db.Uuid
  code           String                  @db.VarChar(100)
  title          String                  @db.VarChar(250)
  category       String                  @db.VarChar(80)
  summary        String?                 @db.VarChar(500)
  body           String
  status         PolicyStatus            @default(DRAFT)
  version        Int                     @default(1)
  effectiveFrom  DateTime?               @db.Timestamptz(6)
  publishedAt    DateTime?               @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)
  archivedAt     DateTime?               @db.Timestamptz(6)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions       PolicyDocumentVersion[]

  @@unique([tenantId, code])
  @@index([tenantId, organizationId, status])
  @@index([organizationId])
}

/// Immutable snapshot of a policy as it was published.
model PolicyDocumentVersion {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  policyId      String         @db.Uuid
  version       Int
  title         String         @db.VarChar(250)
  body          String
  effectiveFrom DateTime?      @db.Timestamptz(6)
  publishedAt   DateTime       @default(now()) @db.Timestamptz(6)
  publishedById String?        @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  policy        PolicyDocument @relation(fields: [policyId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([tenantId, policyId])
}

/// Where a patient sends money for an online consultation that requires
/// prepayment. Tenant data, configured by the hospital's own admin — never
/// hardcoded, since bank details differ per hospital and change over time.
model PaymentAccount {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  method        PaymentAccountMethod @default(BANK_TRANSFER)
  bankName      String?              @db.VarChar(200)
  accountTitle  String               @db.VarChar(200)
  accountNumber String               @db.VarChar(100)
  iban          String?              @db.VarChar(50)
  isEnabled     Boolean              @default(true)
  displayOrder  Int                  @default(0)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isEnabled, displayOrder])
}

model ServiceDefinition {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  branchId            String?             @db.Uuid
  code                String              @db.VarChar(100)
  name                String              @db.VarChar(250)
  category            String              @db.VarChar(100)
  description         String?
  durationMinutes     Int                 @default(15)
  priceMinorUnits     Int?
  currencyCode        String              @default("PKR") @db.Char(3)
  publiclyBookable    Boolean             @default(false)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)
  doctorId            String?             @db.Uuid
  /// Who may set this service price. DOCTOR is only valid on a doctor-linked service.
  billingOwner        ServiceBillingOwner @default(HOSPITAL)
  /// Desk that operates this service when no single person owns it.
  handlerWorkspace    WorkspaceCode?
  /// Specific staff member who operates this service, when one is named.
  handlerMembershipId String?             @db.Uuid
  /// When true, an appointment against this service is created with
  /// paymentStatus AWAITING_PAYMENT and start-consultation readiness blocks
  /// until it is confirmed.
  requiresPrepayment  Boolean             @default(false)
  /// Every mode this service can be booked under at this location. A
  /// service offering both in-person and video visits carries both values;
  /// booking then asks the patient which one, rather than the service
  /// dictating a single fixed mode. Never empty — see the CHECK constraint
  /// added by the migration that introduced this field.
  consultationModes   ConsultationMode[]  @default([IN_PERSON])
  appointments        Appointment[]
  availabilityRules   AvailabilityRule[]
  invoiceLines        InvoiceLine[]
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctor              DoctorProfile?      @relation(fields: [doctorId], references: [id])
  handlerMembership   TenantMembership?   @relation("ServiceHandler", fields: [handlerMembershipId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeHistory          ServiceFeeHistory[]
  feeRequests         DoctorFeeRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId, isActive])
  @@index([tenantId, handlerMembershipId, isActive])
  @@index([tenantId, doctorId, isActive])
  @@index([branchId])
  @@index([doctorId])
  @@index([handlerMembershipId])
}

/// Append-only fee history — a service's price is never overwritten in place
/// without a row here, so a past invoice remains explicable by the price
/// that was actually in effect when it was issued.
model ServiceFeeHistory {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @db.Uuid
  serviceId             String            @db.Uuid
  priceMinorUnits       Int
  currencyCode          String            @db.Char(3)
  changedByMembershipId String            @db.Uuid
  changedAt             DateTime          @default(now()) @db.Timestamptz(6)
  service               ServiceDefinition @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenant                Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId, serviceId, changedAt])
  @@index([serviceId])
}

model AvailabilityRule {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  doctorId     String             @db.Uuid
  branchId     String             @db.Uuid
  serviceId    String?            @db.Uuid
  weekday      Int
  startsMinute Int
  endsMinute   Int
  capacity     Int                @default(1)
  validFrom    DateTime           @db.Date
  validUntil   DateTime?          @db.Date
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctor       DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service      ServiceDefinition? @relation(fields: [serviceId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, doctorId, weekday])
  @@index([tenantId, branchId, isActive])
  @@index([doctorId])
  @@index([branchId])
  @@index([serviceId])
}

/// A doctor's actual sitting hours for one business date at one branch.
/// The hospital roster (AvailabilityRule) is the expected arrival window;
/// a sitting recorded here overrides it when slots are generated.
model DoctorSitting {
  id                         String              @id @default(uuid()) @db.Uuid
  tenantId                   String              @db.Uuid
  doctorId                   String              @db.Uuid
  branchId                   String              @db.Uuid
  businessDate               DateTime            @db.Date
  startsMinute               Int
  endsMinute                 Int
  averageConsultationMinutes Int                 @default(15)
  roomLabel                  String?             @db.VarChar(120)
  status                     DoctorSittingStatus @default(PLANNED)
  actualStartedAt            DateTime?           @db.Timestamptz(6)
  actualEndedAt              DateTime?           @db.Timestamptz(6)
  createdAt                  DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(6)
  branch                     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctor                     DoctorProfile       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  tenant                     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctorId, branchId, businessDate])
  @@index([tenantId, branchId, businessDate])
  @@index([tenantId, doctorId, businessDate])
  @@index([branchId])
  @@index([doctorId])
}

model Appointment {
  id                     String                   @id @default(uuid()) @db.Uuid
  tenantId               String                   @db.Uuid
  patientId              String                   @db.Uuid
  doctorId               String?                  @db.Uuid
  branchId               String                   @db.Uuid
  serviceId              String?                  @db.Uuid
  status                 AppointmentStatus        @default(PENDING)
  source                 String                   @db.VarChar(80)
  reason                 String?
  startsAt               DateTime                 @db.Timestamptz(6)
  endsAt                 DateTime                 @db.Timestamptz(6)
  checkedInAt            DateTime?                @db.Timestamptz(6)
  tokenNumber            Int?
  queueStatus            String?                  @db.VarChar(80)
  version                Int                      @default(1)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(6)
  cancellationReason     String?                  @db.VarChar(1000)
  cancelledAt            DateTime?                @db.Timestamptz(6)
  idempotencyKey         String?                  @db.VarChar(160)
  consultationMode       ConsultationMode         @default(IN_PERSON)
  paymentProofDocumentId String?                  @db.Uuid
  paymentStatus          AppointmentPaymentStatus @default(NOT_REQUIRED)
  branch                 Branch                   @relation(fields: [branchId], references: [id])
  doctor                 DoctorProfile?           @relation(fields: [doctorId], references: [id])
  patient                Patient                  @relation(fields: [patientId], references: [id])
  paymentProofDocument   DocumentRecord?          @relation(fields: [paymentProofDocumentId], references: [id])
  service                ServiceDefinition?       @relation(fields: [serviceId], references: [id])
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  encounter              Encounter?
  queueEntry             QueueEntry?
  videoCallSession       VideoCallSession?

  @@unique([tenantId, idempotencyKey])
  @@unique([doctorId, branchId, startsAt], map: "Appointment_doctor_branch_start_active_key", where: raw("((\"doctorId\" IS NOT NULL) AND (status = ANY (ARRAY['PENDING'::\"AppointmentStatus\", 'CONFIRMED'::\"AppointmentStatus\", 'CHECKED_IN'::\"AppointmentStatus\", 'IN_QUEUE'::\"AppointmentStatus\", 'IN_PROGRESS'::\"AppointmentStatus\"])))"))
  @@unique([tenantId, doctorId, branchId, startsAt], map: "appointment_doctor_branch_start_active_key", where: raw("((\"doctorId\" IS NOT NULL) AND (status <> ALL (ARRAY['CANCELLED'::\"AppointmentStatus\", 'NO_SHOW'::\"AppointmentStatus\"])))"))
  @@index([tenantId, branchId, startsAt, status])
  @@index([tenantId, doctorId, startsAt])
  @@index([tenantId, patientId, startsAt])
  @@index([branchId])
  @@index([doctorId])
  @@index([patientId])
  @@index([serviceId])
}

model VideoCallSession {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  appointmentId   String            @unique @db.Uuid
  status          VideoCallStatus   @default(WAITING)
  patientJoinedAt DateTime?         @db.Timestamptz(6)
  doctorJoinedAt  DateTime?         @db.Timestamptz(6)
  startedAt       DateTime?         @db.Timestamptz(6)
  endedAt         DateTime?         @db.Timestamptz(6)
  expiresAt       DateTime          @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  appointment     Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  signals         VideoCallSignal[]

  @@index([tenantId, status, expiresAt])
}

model VideoCallSignal {
  id         String           @id @default(uuid()) @db.Uuid
  sessionId  String           @db.Uuid
  senderRole String           @db.VarChar(20)
  signalType String           @db.VarChar(20)
  payload    Json
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime         @db.Timestamptz(6)
  session    VideoCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

model Encounter {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  patientId        String                @db.Uuid
  appointmentId    String?               @unique @db.Uuid
  doctorId         String?               @db.Uuid
  branchId         String                @db.Uuid
  status           EncounterStatus       @default(PLANNED)
  reason           String?
  clinicalData     Json?
  signedAt         DateTime?             @db.Timestamptz(6)
  releasedAt       DateTime?             @db.Timestamptz(6)
  version          Int                   @default(1)
  startedAt        DateTime?             @db.Timestamptz(6)
  endedAt          DateTime?             @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(6)
  CarePlan         CarePlan[]
  observations     ClinicalObservation[]
  diagnosticOrders DiagnosticOrder[]
  appointment      Appointment?          @relation(fields: [appointmentId], references: [id])
  branch           Branch                @relation(fields: [branchId], references: [id])
  doctor           DoctorProfile?        @relation(fields: [doctorId], references: [id])
  patient          Patient               @relation(fields: [patientId], references: [id])
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  diagnoses        EncounterDiagnosis[]
  notes            EncounterNote[]
  prescriptions    Prescription[]

  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, doctorId, status])
  @@index([tenantId, branchId, status])
  @@index([branchId])
  @@index([doctorId])
  @@index([patientId])
}

model DiagnosticOrder {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @db.Uuid
  patientId             String               @db.Uuid
  /// Null for a walk-in ordered at reception, which has no clinical encounter.
  encounterId           String?              @db.Uuid
  orderedByMembershipId String               @db.Uuid
  type                  DiagnosticType
  status                DiagnosticStatus     @default(DRAFT)
  priority              String               @default("routine") @db.VarChar(50)
  code                  String               @db.VarChar(120)
  name                  String               @db.VarChar(300)
  specimenOrBodySite    String?              @db.VarChar(200)
  clinicalReason        String?
  orderedAt             DateTime?            @db.Timestamptz(6)
  completedAt           DateTime?            @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(6)
  accessionNumber       String?              @db.VarChar(120)
  branchId              String               @db.Uuid
  branch                Branch               @relation(fields: [branchId], references: [id])
  encounter             Encounter?           @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient               Patient              @relation(fields: [patientId], references: [id])
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  results               DiagnosticResult[]
  specimens             DiagnosticSpecimen[]
  attachments           DocumentRecord[]

  @@unique([tenantId, accessionNumber])
  @@index([tenantId, type, status, createdAt])
  @@index([tenantId, patientId])
  @@index([tenantId, branchId, type, status, createdAt])
  @@index([branchId])
  @@index([encounterId])
  @@index([patientId])
}

model DiagnosticResult {
  id                      String                 @id @default(uuid()) @db.Uuid
  orderId                 String                 @db.Uuid
  status                  DiagnosticResultStatus @default(PRELIMINARY)
  resultData              Json?
  reportText              String?
  critical                Boolean                @default(false)
  criticalNotes           String?
  performedByMembershipId String?                @db.Uuid
  verifiedByMembershipId  String?                @db.Uuid
  releasedByMembershipId  String?                @db.Uuid
  verifiedAt              DateTime?              @db.Timestamptz(6)
  releasedAt              DateTime?              @db.Timestamptz(6)
  correctionReason        String?                @db.VarChar(1000)
  version                 Int                    @default(1)
  createdAt               DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(6)
  acknowledgedAt          DateTime?              @db.Timestamptz(6)
  tenantId                String                 @db.Uuid
  order                   DiagnosticOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id])

  @@index([orderId, status])
  @@index([critical, releasedAt])
  @@index([tenantId, status, releasedAt])
}

model Medication {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @db.Uuid
  code                 String                @db.VarChar(120)
  genericName          String                @db.VarChar(300)
  brandName            String?               @db.VarChar(300)
  strength             String?               @db.VarChar(150)
  dosageForm           String?               @db.VarChar(150)
  unit                 String                @db.VarChar(80)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  /// Tenant-wide low-stock threshold, compared against a branch's total AVAILABLE quantity across batches.
  reorderLevel         Decimal               @default(0) @db.Decimal(18, 4)
  dispenseItems        DispenseItem[]
  inventoryBatches     InventoryBatch[]
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pharmacyReturnLines  PharmacyReturnLine[]
  prescriptionItems    PrescriptionItem[]
  purchaseReceiptLines PurchaseReceiptLine[]
  stockMovements       StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model InventoryBatch {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  branchId       String               @db.Uuid
  medicationId   String               @db.Uuid
  batchNumber    String               @db.VarChar(150)
  expiryDate     DateTime             @db.Date
  quantity       Decimal              @default(0) @db.Decimal(18, 4)
  status         InventoryBatchStatus @default(AVAILABLE)
  version        Int                  @default(1)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  dispenseItems  DispenseItem[]
  branch         Branch               @relation(fields: [branchId], references: [id])
  medication     Medication           @relation(fields: [medicationId], references: [id])
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  stockMovements StockMovement[]

  @@unique([tenantId, branchId, medicationId, batchNumber])
  @@index([tenantId, branchId, status, expiryDate])
  @@index([branchId])
  @@index([medicationId])
}

model Prescription {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  patientId    String             @db.Uuid
  encounterId  String             @db.Uuid
  doctorId     String             @db.Uuid
  status       PrescriptionStatus @default(DRAFT)
  instructions String?
  prescribedAt DateTime?          @db.Timestamptz(6)
  signedAt     DateTime?          @db.Timestamptz(6)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)
  dispenses    Dispense[]
  doctor       DoctorProfile      @relation(fields: [doctorId], references: [id])
  encounter    Encounter          @relation(fields: [encounterId], references: [id])
  patient      Patient            @relation(fields: [patientId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  items        PrescriptionItem[]

  @@index([tenantId, patientId, status])
  @@index([tenantId, doctorId, createdAt])
  @@index([doctorId])
  @@index([encounterId])
  @@index([patientId])
}

model PrescriptionItem {
  id             String         @id @default(uuid()) @db.Uuid
  prescriptionId String         @db.Uuid
  medicationId   String         @db.Uuid
  dose           String         @db.VarChar(250)
  route          String?        @db.VarChar(150)
  frequency      String         @db.VarChar(250)
  duration       String?        @db.VarChar(200)
  quantity       Decimal?       @db.Decimal(18, 4)
  instructions   String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  dispenseItems  DispenseItem[]
  medication     Medication     @relation(fields: [medicationId], references: [id])
  prescription   Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([medicationId])
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  patientId     String        @db.Uuid
  branchId      String        @db.Uuid
  invoiceNumber String        @db.VarChar(120)
  status        InvoiceStatus @default(DRAFT)
  currencyCode  String        @default("PKR") @db.Char(3)
  subtotalMinor Int           @default(0)
  discountMinor Int           @default(0)
  totalMinor    Int           @default(0)
  paidMinor     Int           @default(0)
  issuedAt      DateTime?     @db.Timestamptz(6)

model TherapyAssessment {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String            @db.Uuid
  patientId            String            @db.Uuid
  assessedByStaffId    String            @db.Uuid
  referralId           String?           @db.Uuid
  assessedAt           DateTime          @default(now()) @db.Timestamptz(6)
  mobilityScore        Int
  painScore            Int
  respiratoryFunction  String?           @db.VarChar(200)
  independenceLevel    IndependenceLevel @default(BED_BOUND)
  surgicalRestrictions String?
  baselineNotes        String?
  goals                String?
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  StaffProfile         StaffProfile      @relation(fields: [assessedByStaffId], references: [id])
  Patient              Patient           @relation(fields: [patientId], references: [id])
  ClinicalReferral     ClinicalReferral? @relation(fields: [referralId], references: [id])
  Tenant               Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId, patientId, assessedAt])
  @@index([tenantId, referralId])
}

model ExerciseDefinition {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String           @db.Uuid
  name                    String           @db.VarChar(200)
  category                ExerciseCategory @default(MOBILITY)
  description             String?
  instruction             String
  demonstrationDocumentId String?          @db.Uuid
  demonstrationUrl        String?          @db.VarChar(1000)
  defaultRepetitions      Int?
  defaultSets             Int?
  defaultDurationSeconds  Int?
  precautions             String?
  isActive                Boolean          @default(true)
  createdAt               DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(6)
  Tenant                  Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId, category, isActive])
}

model TherapySession {

{
  "name": "@wonflow/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared runtime validation schemas and helpers for WonFlow.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@wonflow/contracts": "workspace:*"
  }
}
{
  "name": "@wonflow/mock-data",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic fictional demonstration data for the WonFlow frontend.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "audit:fictional": "node ./scripts/audit-fictional.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node ./scripts/audit-fictional.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@wonflow/contracts": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
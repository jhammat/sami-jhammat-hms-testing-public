{
  "name": "@wonflow/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript domain contracts for the WonFlow healthcare platform.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "audit:exports": "node ./scripts/audit-exports.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node ./scripts/audit-exports.mjs && tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}